# Copy this file to .env.local and put your key there.
#
#   cp .env.local.example .env.local
#
# .env.local is gitignored; THIS file is committed — never put a real key here.
#
# The quote agent calls the Gemini API server-side. Without this key the widget
# shows a clean error instead of a conversation; the rest of the demo still works.
#
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
